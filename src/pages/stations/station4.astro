    <!-- ============================================================
         SECTION: Quick Reference
         ============================================================ -->
    <section class="content-section">
        <div class="tips-container">
            <h2 class="section-heading-centered">🎓 Functions Quick Reference</h2>

            <div class="tip-card">
                <div class="tip-number">1</div>
                <div>
                    <h3>Define with function Keyword</h3>
                    <p><code set:html="function name(params) { ... return result; }" /> creates a reusable block of code. The function doesn't run until you call it.</p>
                </div>
            </div>

            <div class="tip-card">
                <div class="tip-number">2</div>
                <div>
                    <h3>Call with Parentheses</h3>
                    <p><code>name(arguments)</code> runs the function. Without parentheses, you get the function itself, not its result.</p>
                </div>
            </div>

            <div class="tip-card">
                <div class="tip-number">3</div>
                <div>
                    <h3>Return Sends Back a Value</h3>
                    <p>Use <code>return</code> to send a value back. Without it, the function returns <code>undefined</code>.</p>
                </div>
            </div>

            <div class="tip-card">
                <div class="tip-number">4</div>
                <div>
                    <h3>Scope Keeps Things Separate</h3>
                    <p>Variables inside a function stay inside. This prevents conflicts and keeps your code organized.</p>
                </div>
            </div>
        </div>
    </section>

</StationLayout>
