    avatarAlt="HAP studying on his laptop"
    introContent={introContent}
    ogImage="https://res.cloudinary.com/cynthia-teeters/image/upload/f_auto,q_auto,w_1200,c_fill,g_auto/v1759495998/hap-laptop_xiewar.jpg"
    nextStationTitle="Repeating Actions"
    footerReminder="Remember: Functions are reusable code factories. Parameters go in, return values come out!"
