/**
 * Station 2: Combining Conditions
 *
 * LEARNING INTENT:
 * - Primary concept: Logical operators (&&, ||, !) combine conditions and short-circuit
 * - Supporting concepts: AND requires both true, OR requires one true, NOT inverts
 * - Explicit non-goals: if/else chains (Station 3), ternary operator
 *
 * CODE EXAMPLE ROLE: Illustrative - Shows how logical operators combine conditions
 */

import StationLayout from '../../layouts/StationLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const introContent = `
    <p><strong>Welcome to Station 2!</strong> After learning about truthy and falsy values, I got excited. But then I ran into a problem: what if I need to check <em>multiple</em> things at once?</p>
    <p class="mt-1">I wanted my Robot ID Card to show a "ready for work" status only when I was online AND had enough energy. I wrote nested if statements and ended up with a tangled mess of code.</p>
    <p class="mt-1">Prof. Teeters looked at my 10 lines of nested conditions and said, "HAP, there's a better way. JavaScript gives you three little operators that can combine any conditions you want."</p>
    <p class="mt-1">That's when I learned about <code>&&</code> (AND), <code>||</code> (OR), and <code>!</code> (NOT) — the logical operators that make complex conditions simple.</p>
    <p class="mt-1">Let me show you how they transformed my code... 🟠</p>
`;
---
