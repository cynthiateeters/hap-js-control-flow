</style>

<script>
    // Function definitions for the demo
    interface FunctionDef {
        name: string;
        param: string;
        paramLabel: string;
        inputType: 'number' | 'text';
        min?: number;
        max?: number;
        defaultValue: string;
        body: string;
        evaluate: (value: any) => { result: string; trace: string; activeLine: number };
    }

    const functions: Record<string, FunctionDef> = {
        getStatus: {
            name: 'getStatus',
            param: 'value',
            paramLabel: 'Value:',
            inputType: 'number',
            min: 0,
            max: 100,
            defaultValue: '72',
            body: `function getStatus(<span class="param-highlight">value</span>) {
    <span class="comment">// value = <span class="param-value">72</span></span>
    <span class="code-line" id="line-1"><span class="keyword">if</span> (<span class="param-highlight">value</span> &gt; 75) <span class="keyword">return</span> <span class="string">"High"</span>;</span>
    <span class="code-line" id="line-2"><span class="keyword">if</span> (<span class="param-highlight">value</span> &gt; 25) <span class="keyword">return</span> <span class="string">"Medium"</span>;</span>
    <span class="code-line" id="line-3"><span class="keyword">return</span> <span class="string">"Low"</span>;</span>
}`,
            evaluate: (value: number) => {
                if (value > 75) return { result: '"High"', trace: `${value} > 75? Yes! → return "High"`, activeLine: 1 };
                if (value > 25) return { result: '"Medium"', trace: `${value} > 75? No. ${value} > 25? Yes! → return "Medium"`, activeLine: 2 };
                return { result: '"Low"', trace: `${value} > 75? No. ${value} > 25? No. → return "Low"`, activeLine: 3 };
            }
        },
        makeGreeting: {
            name: 'makeGreeting',
            param: 'name',
            paramLabel: 'Name:',
            inputType: 'text',
            defaultValue: 'HAP',
            body: `function makeGreeting(<span class="param-highlight">name</span>) {
    <span class="comment">// name = "<span class="param-value">HAP</span>"</span>
    <span class="code-line" id="line-1"><span class="keyword">return</span> <span class="string">"Hello, "</span> + <span class="param-highlight">name</span> + <span class="string">"!"</span>;</span>
}`,
            evaluate: (name: string) => {
                return { result: `"Hello, ${name}!"`, trace: `Concatenate "Hello, " + "${name}" + "!"`, activeLine: 1 };
            }
        },
        formatEnergy: {
            name: 'formatEnergy',
            param: 'level',
            paramLabel: 'Level:',
            inputType: 'number',
            min: 0,
            max: 100,
            defaultValue: '100',
            body: `function formatEnergy(<span class="param-highlight">level</span>) {
    <span class="comment">// level = <span class="param-value">100</span></span>
    <span class="code-line" id="line-1"><span class="keyword">return</span> <span class="param-highlight">level</span> + <span class="string">"%"</span>;</span>
}`,
            evaluate: (level: number) => {
                return { result: `"${level}%"`, trace: `Concatenate ${level} + "%" → "${level}%"`, activeLine: 1 };
            }
        },
        isReadyForTask: {
            name: 'isReadyForTask',
            param: 'energy',
            paramLabel: 'Energy:',
            inputType: 'number',
            min: 0,
            max: 100,
            defaultValue: '72',
            body: `function isReadyForTask(<span class="param-highlight">energy</span>) {
    <span class="comment">// energy = <span class="param-value">72</span></span>
    <span class="code-line" id="line-1"><span class="keyword">return</span> <span class="param-highlight">energy</span> &gt; 20;</span>
}`,
            evaluate: (energy: number) => {
                const result = energy > 20;
                return { result: result.toString(), trace: `${energy} > 20? ${result ? 'Yes' : 'No'} → return ${result}`, activeLine: 1 };
            }
        }
    };

    let currentFunction = 'getStatus';

    // DOM Elements
    const functionBtns = document.querySelectorAll('.function-btn');
    const argSlider = document.getElementById('arg-slider') as HTMLInputElement;
    const argInput = document.getElementById('arg-input') as HTMLInputElement;
    const argLabel = document.getElementById('arg-label');
    const functionCall = document.getElementById('function-call');
    const functionBody = document.getElementById('function-body');
    const executionTrace = document.getElementById('execution-trace');
    const outputDisplay = document.getElementById('output-display');
    const outputCall = document.getElementById('output-call');
    const quickValueBtns = document.querySelectorAll('.quick-value-btn');

    function updateDisplay() {
        const func = functions[currentFunction];
        const value = func.inputType === 'number' ? parseFloat(argInput.value) || 0 : argInput.value;
        const { result, trace, activeLine } = func.evaluate(value);

        // Update function call display
        if (functionCall) {
            functionCall.innerHTML = `${func.name}(<span class="arg-highlight">${func.inputType === 'text' ? '"' + value + '"' : value}</span>)`;
        }

        // Update function body with current value
        if (functionBody) {
            let bodyHtml = func.body.replace(/<span class="param-value">[^<]*<\/span>/g, `<span class="param-value">${value}</span>`);
            functionBody.innerHTML = bodyHtml;

            // Highlight active line
            const lines = functionBody.querySelectorAll('.code-line');
            lines.forEach((line, index) => {
                line.classList.remove('active', 'skipped');
                if (index + 1 === activeLine) {
                    line.classList.add('active');
                } else if (index + 1 < activeLine) {
                    line.classList.add('skipped');
                }
            });
        }

        // Update execution trace
        if (executionTrace) {
            executionTrace.innerHTML = `<span class="trace-icon">🔍</span><span class="trace-text">${trace}</span>`;
        }

        // Update output
        if (outputDisplay) {
            outputDisplay.innerHTML = `<span class="output-value">${result}</span>`;
        }

        if (outputCall) {
            outputCall.textContent = `${func.name}(${func.inputType === 'text' ? '"' + value + '"' : value})`;
        }
    }

    function switchFunction(funcName: string) {
        currentFunction = funcName;
        const func = functions[funcName];

        // Update active button
        functionBtns.forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('data-function') === funcName);
        });

        // Update input controls
        if (argLabel) {
            argLabel.textContent = func.paramLabel;
        }

        if (func.inputType === 'number') {
            argSlider.style.display = 'block';
            argSlider.min = String(func.min || 0);
            argSlider.max = String(func.max || 100);
            argSlider.value = func.defaultValue;
            argInput.type = 'text';
            argInput.value = func.defaultValue;
        } else {
            argSlider.style.display = 'none';
            argInput.type = 'text';
            argInput.value = func.defaultValue;
        }

        updateDisplay();
    }

    // Event listeners
    functionBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const funcName = btn.getAttribute('data-function');
            if (funcName) switchFunction(funcName);
        });
    });

    argSlider?.addEventListener('input', () => {
        argInput.value = argSlider.value;
        updateDisplay();
    });

    argInput?.addEventListener('input', () => {
        if (functions[currentFunction].inputType === 'number') {
            argSlider.value = argInput.value;
        }
        updateDisplay();
    });

    quickValueBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const value = btn.getAttribute('data-value') || '0';
            argInput.value = value;
            if (functions[currentFunction].inputType === 'number') {
                argSlider.value = value;
            }
            updateDisplay();
        });
    });

    // Initialize
    updateDisplay();
</script>
