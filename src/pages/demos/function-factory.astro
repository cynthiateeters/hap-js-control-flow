---
/**
 * Function Factory Demo
 *
 * Interactive tool to explore how functions work with parameters and return values.
 * Students can adjust inputs and watch the function "factory" process them.
 */

import MainLayout from '../../layouts/MainLayout.astro';

const introContent = `
    <p><strong>Watch the function factory in action!</strong> Adjust the inputs and see how parameters receive values, the function body executes, and return values come out. Try different Robot ID Card values!</p>
`;
---
<!--
HAP Educational Content © 2026 Cynthia Teeters. All rights reserved.
HyBit A. ProtoBot (HAP) character and the apprentice learning methodology are proprietary educational innovations.
-->

<MainLayout
    title="Function Factory | HAP's Learning Lab"
    description="Interactive demo to explore JavaScript functions. Watch parameters receive arguments and return values emerge from the function factory."
    headerTitle="Function Factory"
    headerSubtitle="Station 4 Demo"
    avatarImage="https://res.cloudinary.com/cynthia-teeters/image/upload/f_auto,q_auto,w_200,c_limit/v1759331578/hap-chef.jpg"
    avatarAlt="HAP ready to create like a chef"
    introContent={introContent}
    showNavigation={false}
    footerReminder="Remember: Parameters are placeholders, arguments are actual values. Return sends the result back!"
>

    <section class="content-section">
        <div class="topic-section">
            <!-- Function Selector -->
            <div class="demo-container">
                <h2>Choose a Function</h2>

                <div class="function-selector">
                    <button class="function-btn active" data-function="getStatus">getStatus(value)</button>
                    <button class="function-btn" data-function="makeGreeting">makeGreeting(name)</button>
                    <button class="function-btn" data-function="formatEnergy">formatEnergy(level)</button>
                    <button class="function-btn" data-function="isReadyForTask">isReadyForTask(energy)</button>
                </div>
            </div>

            <!-- Function Factory Visualization -->
            <div class="factory-container mt-2">
                <h3>The Function Factory</h3>

                <!-- Input Section -->
                <div class="factory-section input-section">
                    <div class="section-label">INPUT (Argument)</div>
                    <div class="input-controls">
                        <label for="arg-input" class="input-label" id="arg-label">Value:</label>
                        <input type="range" id="arg-slider" min="0" max="100" value="72" class="arg-slider">
                        <input type="text" id="arg-input" value="72" class="arg-input" aria-labelledby="arg-label">
                    </div>
                    <div class="input-preview">
                        <code id="function-call">getStatus(<span class="arg-highlight">72</span>)</code>
                    </div>
                </div>

                <!-- Arrow -->
                <div class="factory-arrow">
                    <span class="arrow-icon">⬇️</span>
                    <span class="arrow-label">argument becomes parameter</span>
                </div>

                <!-- Function Body -->
                <div class="factory-section body-section">
                    <div class="section-label">FUNCTION BODY</div>
                    <div class="code-panel">
                        <pre class="code-display"><code id="function-body" set:html={`function getStatus(<span class="param-highlight">value</span>) {
    <span class="comment">// value = 72</span>
    <span class="code-line" id="line-1"><span class="keyword">if</span> (<span class="param-highlight">value</span> &gt; 75) <span class="keyword">return</span> <span class="string">"High"</span>;</span>
    <span class="code-line" id="line-2"><span class="keyword">if</span> (<span class="param-highlight">value</span> &gt; 25) <span class="keyword">return</span> <span class="string">"Medium"</span>;</span>
    <span class="code-line" id="line-3"><span class="keyword">return</span> <span class="string">"Low"</span>;</span>
}`} /></pre>
                    </div>
                    <div class="execution-trace" id="execution-trace">
                        <span class="trace-icon">🔍</span>
                        <span class="trace-text">72 > 75? No. 72 > 25? Yes! → return "Medium"</span>
                    </div>
                </div>

                <!-- Arrow -->
                <div class="factory-arrow">
                    <span class="arrow-icon">⬇️</span>
                    <span class="arrow-label">return sends back the result</span>
                </div>

                <!-- Output Section -->
                <div class="factory-section output-section">
                    <div class="section-label">OUTPUT (Return Value)</div>
                    <div class="output-display" id="output-display">
                        <span class="output-value">"Medium"</span>
                    </div>
                    <div class="output-assignment">
                        <code>let result = <span id="output-call">getStatus(72)</span>;  <span class="comment">// result = "Medium"</span></code>
                    </div>
                </div>
            </div>

            <!-- Robot ID Card Quick Values -->
            <div class="demo-section mt-2">
                <h3>Quick Test: Robot ID Card Values</h3>
                <p class="mb-1">Click to test with HAP's actual values:</p>
                <div class="quick-test-grid">
                    <button class="quick-value-btn" data-value="100" data-label="energyLevel">energyLevel (100)</button>
                    <button class="quick-value-btn" data-value="72" data-label="coreTemperature">coreTemperature (72)</button>
                    <button class="quick-value-btn" data-value="0" data-label="backupBattery">backupBattery (0)</button>
                    <button class="quick-value-btn" data-value="0" data-label="tasksDone">tasksDone (0)</button>
                    <button class="quick-value-btn" data-value="15" data-label="lowEnergy">Low energy (15)</button>
                    <button class="quick-value-btn" data-value="95" data-label="highTemp">High temp (95)</button>
                </div>
            </div>

            <!-- Scope Demonstration -->
            <div class="demo-section mt-2">
                <h3>Scope: Variables Inside Stay Inside</h3>
                <div class="scope-demo">
                    <div class="scope-box scope-outer">
                        <div class="scope-label">Outside the function</div>
                        <code class="scope-var">let result = getStatus(72);  <span class="comment">// "Medium"</span></code>
                        <code class="scope-var scope-error">console.log(value);  <span class="comment">// ❌ Error! value is not defined</span></code>

                        <div class="scope-box scope-inner">
                            <div class="scope-label">Inside getStatus()</div>
                            <code class="scope-var scope-ok">let value = 72;  <span class="comment">// ✅ Exists here</span></code>
                            <code class="scope-var scope-ok">return "Medium";  <span class="comment">// ✅ Sent back</span></code>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Back to Station Link -->
            <div class="demo-nav mt-2">
                <a href="/stations/station4/" class="demo-back-link">← Back to Station 4: Reusable Code with Functions</a>
            </div>
        </div>
    </section>

</MainLayout>

<style>
